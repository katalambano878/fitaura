# Application
NEXT_PUBLIC_APP_URL=https://shopfitaura.com

# --- Plain Postgres cutover (Coolify / big-vps) ---
# Set these three together. When DATABASE_URL is set, the app uses the in-process
# PostgREST/Auth/Storage shims instead of hosted Supabase.
DATABASE_URL=postgresql://user:password@fleet-postgres:5432/fitaura_staging
NEXT_PUBLIC_USE_PLAIN_PG=true
# Must be the public app origin (not *.supabase.co) in plain-Postgres mode:
NEXT_PUBLIC_SUPABASE_URL=https://fitaura-staging.169-58-8-203.sslip.io

# Auth / signing (required in production when using plain Postgres)
AUTH_JWT_SECRET=change-me-long-random-string
# Optional aliases: JWT_SECRET, SUPABASE_JWT_SECRET

# Browser anon key (still sent by supabase-js; used for actor resolution)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-app-key
# Server service role (required for admin middleware fallback + REST service actor)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-app-key

# Local disk storage (plain Postgres)
STORAGE_ROOT=/var/www/fitaura/uploads
STORAGE_PUBLIC_URL=https://fitaura-staging.169-58-8-203.sslip.io
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret
PG_POOL_MAX=10
# PGSSL=require

# Legacy hosted Supabase (only if NOT using DATABASE_URL)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Email (Resend) — optional
RESEND_API_KEY=
ADMIN_EMAIL=admin@shopfitaura.com
EMAIL_FROM=FITAURA <noreply@shopfitaura.com>

# Stripe payment gateway (required for checkout)
#   - Publishable key (pk_test_… or pk_live_…) is shipped to the browser.
#   - Secret key (sk_test_… or sk_live_…) is server-only — never expose it.
#   - Webhook secret (whsec_…) from `stripe listen` (dev) or Dashboard webhooks.
#     Endpoint: https://YOUR_DOMAIN/api/payment/stripe/webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMS (Moolre) — optional (transactional SMS only; payments use Stripe)
MOOLRE_SMS_API_KEY=
MOOLRE_API_KEY=

# Analytics, Search Console & reCAPTCHA — optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cron (payment reminders) — REQUIRED if the cron route is publicly reachable
CRON_SECRET=change-me-cron-secret
